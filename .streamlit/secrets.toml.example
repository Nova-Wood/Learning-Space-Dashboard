# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Cloud Secrets.
# Use a long, unique password. This application is for one owner.
APP_PASSWORD = "replace-with-a-long-unique-password"
SUPABASE_URL = "https://YOUR_PROJECT.supabase.co"
# Server-only service_role key; NEVER send it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY = "replace-with-server-side-service-role-key"

# Optional: generated by scripts/connect_google_calendar.py after you authorize.
# [google_calendar]
# client_id = "YOUR_DESKTOP_OAUTH_CLIENT_ID"
# client_secret = "YOUR_DESKTOP_OAUTH_CLIENT_SECRET"
# refresh_token = "YOUR_OFFLINE_REFRESH_TOKEN"
# calendar_id = "primary"
# readonly = false
